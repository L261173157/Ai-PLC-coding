<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>0.1.0</AssemblyVersion>
    <FileVersion>0.1.0</FileVersion>
    <Version>0.1.0</Version>
    <Authors>TiaMcp</Authors>
    <!--
      TIA V21 is net48-only, so the real Openness code lives in TiaMcp.Openness.Worker (net48, not in
      TiaMcp.slnx); it defines HAVE_TIA_SDK + TiaInstallDir/TiaApiVersion itself. The net10
      TiaMcp.Openness project is just the bridge (no Siemens refs). Nothing here gates on HaveTiaSdk anymore.
    -->
  </PropertyGroup>
</Project>
